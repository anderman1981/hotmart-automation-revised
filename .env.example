# Environment variables example
# Copy this file to .env and fill in your actual values

# Database Configuration
VP_DB_USER=hotmart_user
VP_DB_PASSWORD=your_secure_password_here
VP_DB_NAME=hotmart

# Hotmart Credentials
HOTMART_EMAIL=your_hotmart_email@example.com
HOTMART_PASSWORD=your_hotmart_password

# Instagram Credentials (optional)
INSTAGRAM_USER=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# n8n Configuration
N8N_LICENSE_TOKEN=your_n8n_license_token

# Docker Registry Configuration
GITHUB_TOKEN=your_github_token
DOCKER_REGISTRY=ghcr.io

# Monitoring Configuration
SENTRY_DSN=your_sentry_dsn
DATADOG_API_KEY=your_datadog_api_key
GRAFANA_PASSWORD=your_grafana_password

# Email Configuration for Notifications
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
NOTIFICATION_EMAIL=admin@example.com

# Slack Configuration
SLACK_WEBHOOK_URL=your_slack_webhook_url
SECURITY_SLACK_WEBHOOK_URL=your_security_slack_webhook_url

# Snyk Security Scanning
SNYK_TOKEN=your_snyk_token

# Production Secrets (replace with actual values in production)
PROD_DB_PASSWORD=your_prod_db_password
PROD_REDIS_PASSWORD=your_prod_redis_password
PROD_HOTMART_EMAIL=prod@hotmart.com
PROD_HOTMART_PASSWORD=your_prod_hotmart_password
PROD_JWT_SECRET=your_jwt_secret_key
PROD_ENCRYPTION_KEY=your_encryption_key
PROD_N8N_API_KEY=your_n8n_api_key

# AWS Configuration (for S3 storage)
S3_ACCESS_KEY=your_aws_access_key
S3_SECRET_KEY=your_aws_secret_key

# SendGrid Configuration
SENDGRID_USERNAME=your_sendgrid_username
SENDGRID_PASSWORD=your_sendgrid_password

# Backup Configuration
BACKUP_ENCRYPTION_KEY=your_backup_encryption_key