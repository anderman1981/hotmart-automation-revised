# ═══════════════════════════════════════════════════════════════
# HOTMART AUTOMATION - Environment Configuration
# Copy this file to .env and fill in your actual values
# ═══════════════════════════════════════════════════════════════

# Server
PORT=4200
NODE_ENV=production

# Database (PostgreSQL)
DB_USER=hotmart_user
DB_HOST=127.0.0.1
DB_PORT=8501
DB_NAME=hotmart
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Ollama LLM
OLLAMA_HOST=http://127.0.0.1:11434

# Hotmart Credentials
HOTMART_EMAIL=your_email@example.com
HOTMART_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# Hotmart API Credentials (for getting real offer codes)
# Get from: Hotmart → Tools → Developer Tools → Credentials
HOTMART_CLIENT_ID=your_client_id_here
HOTMART_CLIENT_SECRET=your_client_secret_here

# Hotmart Affiliate Code
HOTMART_AFFILIATE_CODE=your_affiliate_code_here

# Instagram Credentials
INSTAGRAM_USER=your_email@example.com
INSTAGRAM_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# N8N Integration
N8N_WEBHOOK_URL=http://localhost:4123/webhook/manager-event

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:4201,https://hotmart.andersonmares.com

# Security
API_KEY=GENERATE_RANDOM_KEY_HERE
ENCRYPTION_KEY=GENERATE_RANDOM_32_BYTE_HEX_HERE

# Puppeteer
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
